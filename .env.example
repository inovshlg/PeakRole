# ---- Required on Vercel ----
# Postgres connection string. Added automatically when you connect a Neon database in Vercel → Storage.
DATABASE_URL=
# Claude API key for CV reading + job matching (console.anthropic.com). Without it, matching falls back to keywords.
ANTHROPIC_API_KEY=
# Any long random string; Vercel Cron sends it so only Vercel can trigger the import/alert jobs.
CRON_SECRET=

# ---- Optional ----
# ANTHROPIC_MODEL=claude-opus-5-5
# Public URL of the site (defaults to the Vercel production URL)
# SITE_URL=https://yourdomain.com
# Adzuna job API (free key at developer.adzuna.com)
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# Job-alert emails via Resend (otherwise they are only logged)
# RESEND_API_KEY=
# ALERTS_FROM_EMAIL=alerts@yourdomain.com
# Stripe for Premium checkout
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=
# Set to 1 to create the demo logins (demo1234) and allow free "demo upgrades" in production
# SEED_DEMO_USERS=1
# DEMO_UPGRADES=1
