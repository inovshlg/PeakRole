# Optional: Adzuna job API (free key at https://developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Optional: send job-alert emails via Resend (otherwise they are printed to the console)
RESEND_API_KEY=
ALERTS_FROM_EMAIL=alerts@yourdomain.com
# Optional: Stripe for Premium checkout (otherwise "demo upgrade" is used)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Public URL of the site (used in emails, Stripe redirects and SEO)
SITE_URL=http://localhost:3000
